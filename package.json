{
  "name": "bkunz.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "build": "react-router build && cp build/client/__spa-fallback.html build/client/404.html",
    "preview": "vite preview --outDir build/client --port 4173",
    "typecheck": "react-router typegen && tsc --noEmit",
    "ship": "pnpm build && wrangler deploy",
    "ship:production": "pnpm build && wrangler deploy --env production",
    "lint:collision": "node scripts/lint-collision.mjs",
    "check": "pnpm typecheck && pnpm lint:collision"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-router/node": "^8.5.2",
    "@tabler/icons-react": "^3.52.0",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "description": "Personal site of Bernardo Kunz: static, prerendered, terminal look.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javabetatester/bkunz.dev"
  },
  "engines": {
    "node": ">=26"
  }
}
